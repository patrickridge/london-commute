# Copy to .env.local and add a free key from https://api-portal.tfl.gov.uk (Profile page).
# Optional: TfL works without a key, but with a much lower rate limit.
TFL_APP_KEY=

# Commute alerts (optional; the alerts card is hidden without them).
# Push keys: generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any long random string; the scheduler sends it to /api/alerts/run.
CRON_SECRET=
# Storage for alert sign-ups: added automatically by Vercel's Upstash Redis integration.
# Without it, sign-ups are kept in memory (fine for local development only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
